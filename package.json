{
  "name": "carola-piola",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time Spanish text-to-speech with Kokoro 82M and WebGPU",
  "author": "Carola Piola",
  "license": "CC0-1.0",
  "homepage": "https://carolapiola.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carolapiola/carolapiola.github.io.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "download:model": "node scripts/download-offline-model.mjs",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win portable --x64",
    "package:mac": "npm run build && electron-builder --mac zip --arm64",
    "package:linux": "npm run build && electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "10.0.0",
    "dictionary-es-ar": "^2.0.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.6",
    "ephone": "^1.0.2",
    "most-common-words-by-language": "^3.0.14",
    "nspell": "^2.1.5",
    "vite": "8.1.5",
    "wait-on": "9.0.3"
  },
  "build": {
    "appId": "com.carolapiola.tts",
    "productName": "Carola Piola",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "extraResources": [
      {
        "from": "node_modules/ephone/COPYING",
        "to": "licenses/ephone-GPL-3.0.txt"
      },
      {
        "from": "node_modules/dictionary-es-ar/license",
        "to": "licenses/dictionary-es-ar.txt"
      },
      {
        "from": "node_modules/@huggingface/transformers/LICENSE",
        "to": "licenses/Kokoro-Apache-2.0.txt"
      },
      {
        "from": "offline-models",
        "to": "offline-models",
        "filter": ["**/*"]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ]
  }
}
